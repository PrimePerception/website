{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "prime-about-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-27",
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": false },
  "vars": {
    "ENVIRONMENT": "production",
    "FIXTURES_ENABLED": "false",
    "ALLOWED_ORIGINS": "https://primeperception.ca",
  },
  "d1_databases": [
    {
      "binding": "ABOUT_DB",
      "database_name": "prime-about",
      "database_id": "REPLACE_WITH_PRODUCTION_D1_ID",
      "migrations_dir": "migrations",
    },
  ],
  "ratelimits": [
    {
      "name": "PUBLIC_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 180, "period": 60 },
    },
    {
      "name": "WRITE_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 30, "period": 60 },
    },
  ],
  "triggers": { "crons": ["* * * * *", "17 8 * * *"] },
}
