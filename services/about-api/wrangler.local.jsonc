{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "prime-about-api-local",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-27",
  "workers_dev": false,
  "observability": { "enabled": false },
  "vars": {
    "ENVIRONMENT": "local",
    "FIXTURES_ENABLED": "true",
    "ALLOWED_ORIGINS": "http://localhost:4321,http://127.0.0.1:4321,http://localhost:4322,http://127.0.0.1:4322",
    "VISITOR_SIGNING_SECRET": "local-fixture-signing-key-not-for-production-2026",
    "IP_HASH_SECRET": "local-fixture-ip-key-not-for-production-2026",
  },
  "d1_databases": [
    {
      "binding": "ABOUT_DB",
      "database_name": "prime-about-local",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  "ratelimits": [
    {
      "name": "PUBLIC_LIMITER",
      "namespace_id": "1003",
      "simple": { "limit": 180, "period": 60 },
    },
    {
      "name": "WRITE_LIMITER",
      "namespace_id": "1004",
      "simple": { "limit": 30, "period": 60 },
    },
  ],
}
