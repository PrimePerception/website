---
import Layout from '~/layouts/PageLayout.astro';
import { getPermalink } from '~/utils/permalinks';

const metadata = {
  title: 'Page not found',
  robots: { index: false, follow: true },
};
---

<Layout metadata={metadata}>
  <div class="lab-shell">
    <section class="lab-page-intro min-h-[60vh]" aria-labelledby="not-found-title">
      <p class="lab-eyebrow mb-6">404 / Wrong turn</p>
      <h1 id="not-found-title" class="lab-title">An unexplored path.</h1>
      <p class="lab-lede mt-6">
        That page could not be found. The research highlights are a good place to pick things up.
      </p>
      <div class="lab-actions">
        <a class="lab-button" href={getPermalink('/research-highlights')}
          >Explore research highlights <span aria-hidden="true">→</span></a
        >
        <a class="lab-text-link" href={getPermalink('/')}>Return home</a>
      </div>
    </section>
  </div>
</Layout>
