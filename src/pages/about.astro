---
import Layout from '~/layouts/PageLayout.astro';
import { researchIntroduction } from '~/data/research';
import { getPermalink } from '~/utils/permalinks';

const metadata = {
  title: 'About',
  description:
    'Abteen Arab’s research interests in vision and its interplay with other modalities, including geometry, action, and computational medicine.',
};
---

<Layout metadata={metadata}>
  <div class="lab-shell">
    <section class="lab-page-intro" aria-labelledby="about-title">
      <h1 id="about-title" class="lab-title max-w-4xl">About</h1>
      <p class="lab-lede mt-7">I'm Abteen Arab. {researchIntroduction}</p>
    </section>

    <section class="lab-rule lab-section" aria-label="Explore the work">
      <a class="lab-text-link" href={getPermalink('/research-highlights')}
        >Explore research highlights <span aria-hidden="true">→</span></a
      >
    </section>
  </div>
</Layout>
