---
import Layout from '~/layouts/PageLayout.astro';
import PublicTools from '~/components/PublicTools.astro';

const metadata = {
  title: 'Public Tools',
  description:
    'Tools built and shared by Abteen Arab, including Runpod Desktop, a macOS widget for monitoring Runpod GPUs.',
};
---

<Layout metadata={metadata}>
  <div class="lab-shell">
    <section class="lab-page-intro" aria-labelledby="public-tools-title">
      <p class="lab-eyebrow mb-3">Built to share</p>
      <h1 id="public-tools-title" class="lab-title">Public Tools</h1>
      <p class="lab-text mt-7">Small tools I build for my own workflow and share with the community.</p>
    </section>
    <div class="pb-12 md:pb-16">
      <PublicTools headingLevel="h2" />
    </div>
  </div>
</Layout>
