---
import Layout from '~/layouts/PageLayout.astro';
import ProjectEntry from '~/components/ProjectEntry.astro';
import StructuredData from '~/components/common/StructuredData.astro';
import PerceptionStudy from '~/components/PerceptionStudy.astro';
import TeachingCards from '~/components/TeachingCards.astro';
import TypingIntro from '~/components/TypingIntro.astro';
import { SITE, I18N, METADATA } from 'astrowind:config';
import { projects } from '~/data/projects';
import { researchAreas } from '~/data/research';
import { getPermalink } from '~/utils/permalinks';

const metadata = {
  title: SITE.name,
  ignoreTitleTemplate: true,
  description: METADATA.description,
};

const studies = [
  { kind: 'visual', title: 'Visual Geometry', area: 'visual-geometry-models' },
  { kind: 'world', title: 'World Geometry', area: 'world-geometry-models' },
  { kind: 'action', title: 'Embodied Geometry Action', area: 'geometry-action-models' },
  { kind: 'pathology', title: 'Computational Pathology', area: 'computational-medicine' },
] as const;

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.name,
  url: SITE.site,
  inLanguage: I18N.language,
};
---

<Layout metadata={metadata}>
  <StructuredData slot="head" schema={structuredData} />
  <div class="lab-shell">
    <section class="lab-hero" aria-labelledby="home-title">
      <div>
        <p class="lab-eyebrow"><span class="lab-status-dot" aria-hidden="true"></span>Personal research lab</p>
        <h1 id="home-title" class="lab-display">Exploring how<br /><span class="text-primary">machines see.</span></h1>
        <TypingIntro
          text="Hi! I'm Abteen Arab, and welcome to my personal lab. This space serves as a personal research wiki where I document ongoing projects, ideas, experiments, and directions that I find interesting."
        />
        <div class="lab-actions">
          <a class="lab-button" href={getPermalink('/research-highlights')}
            >Explore research highlights <span aria-hidden="true">↗</span></a
          >
          <a class="lab-text-link" href={getPermalink('/about')}>Behind the lab <span aria-hidden="true">→</span></a>
        </div>
      </div>
      <ul class="perception-studies" aria-label="Explore research areas">
        {
          studies.map((study, index) => (
            <li>
              <PerceptionStudy
                kind={study.kind}
                title={study.title}
                number={`00${index + 1}`}
                href={`${getPermalink('/research-highlights')}#area-${study.area}`}
              />
            </li>
          ))
        }
      </ul>
    </section>

    <section class="lab-rule lab-section" aria-labelledby="selected-title">
      <div class="mb-10 flex flex-wrap items-end justify-between gap-5">
        <div>
          <p class="lab-eyebrow mb-3">01 / On the workbench</p>
          <h2 id="selected-title" class="lab-section-heading">Selected work</h2>
        </div>
        <a class="lab-text-link" href={getPermalink('/research-highlights')}
          >All research highlights <span aria-hidden="true">→</span></a
        >
      </div>
      <div class="space-y-12">
        {projects.map((project) => <ProjectEntry project={project} compact />)}
      </div>
    </section>

    <section class="lab-rule lab-section" aria-labelledby="research-title">
      <p class="lab-eyebrow mb-3">02 / Research directions</p>
      <h2 id="research-title" class="lab-section-heading mb-10">Research areas</h2>
      <ol class="grid list-none gap-10 p-0 md:grid-cols-2 md:gap-12">
        {
          researchAreas.map((area, index) => {
            const areaProjects = projects.filter((project) => project.area === area.title);

            return (
              <li>
                <span class="lab-eyebrow" aria-hidden="true">
                  0{index + 1}
                </span>
                <h3 class="mt-4 mb-3 text-xl font-medium text-heading">{area.title}</h3>
                <p class="lab-text">{area.description}</p>
                {areaProjects.length > 0 && (
                  <ul class="mt-5 list-none space-y-2 p-0">
                    {areaProjects.map((project) => (
                      <li>
                        <a class="lab-text-link" href={project.href} target="_blank" rel="noopener noreferrer">
                          {project.title} <span aria-hidden="true">↗</span>
                          <span class="sr-only"> (opens in a new tab)</span>
                        </a>
                      </li>
                    ))}
                  </ul>
                )}
              </li>
            );
          })
        }
      </ol>
    </section>

    <section id="teachings" class="lab-rule lab-section lab-teachings" aria-labelledby="teachings-title">
      <p class="lab-eyebrow mb-3">03 / In the classroom</p>
      <h2 id="teachings-title" class="lab-section-heading">Teachings</h2>
      <p class="lab-text mt-4 mb-8">
        Teaching and course support in biomedical engineering at the University of British Columbia.
      </p>
      <TeachingCards />
    </section>
  </div>
</Layout>
