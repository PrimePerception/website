---
import Layout from '~/layouts/PageLayout.astro';
import TeachingCards from '~/components/TeachingCards.astro';

const metadata = {
  title: 'Teachings',
  description:
    'Teaching and course support in biomedical engineering at the University of British Columbia by Abteen Arab.',
};
---

<Layout metadata={metadata}>
  <div class="lab-shell">
    <section class="lab-page-intro" aria-labelledby="teachings-title">
      <p class="lab-eyebrow mb-3">In the classroom</p>
      <h1 id="teachings-title" class="lab-title">Teachings</h1>
      <p class="lab-text mt-7">
        Teaching and course support in biomedical engineering at the University of British Columbia.
      </p>
    </section>
    <div class="pb-12 md:pb-16">
      <TeachingCards headingLevel="h2" />
    </div>
  </div>
</Layout>
