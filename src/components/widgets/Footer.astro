---
import Logo from '~/components/Logo.astro';
import { getHomePermalink } from '~/utils/permalinks';

interface Link {
  text?: string;
  href?: string;
  ariaLabel?: string;
}

export interface Props {
  links?: Array<{ title?: string; links: Array<Link> }>;
  footNote?: string;
}

const { links = [], footNote = '' } = Astro.props;
---

<footer class="lab-footer">
  <div class="lab-shell">
    <div class="lab-footer-top">
      <div>
        <a href={getHomePermalink()}><Logo class="text-xl md:text-xl" /></a>
        <p class="mt-3 text-xs text-muted">A personal lab by Abteen Arab.</p>
      </div>
      <nav aria-label="Footer navigation">
        <ul class="flex flex-wrap gap-x-7 gap-y-3 text-xs text-muted">
          {
            links
              .flatMap((group) => group.links)
              .map(({ text, href, ariaLabel }) => (
                <li>
                  <a class="transition-colors hover:text-primary" href={href} aria-label={ariaLabel}>
                    {text}
                  </a>
                </li>
              ))
          }
        </ul>
      </nav>
    </div>
    <div class="lab-footer-bottom">
      <span>{footNote}</span>
      <span>Research. Experiments. Open questions.</span>
    </div>
  </div>
</footer>
